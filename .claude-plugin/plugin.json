{
  "name": "privacy-shield",
  "version": "2.0.0",
  "description": "Detect PII and PHI locally, produce a clean overlay, and block unsafe egress before content reaches an external model.",
  "author": {
    "name": "Loomground Contributors"
  },
  "keywords": [
    "privacy",
    "pii",
    "redaction",
    "egress",
    "overlay",
    "data-protection",
    "local-first",
    "governance"
  ],
  "mcpServers": {
    "loomground": {
      "command": "loomground-mcp",
      "args": [
        "serve",
        "--transport",
        "stdio"
      ]
    }
  }
}
